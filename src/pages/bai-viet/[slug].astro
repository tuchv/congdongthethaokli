---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.(md|mdoc|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const review = post.data.venueReview;
---

<Layout title={`${post.data.title} | Cộng Đồng Thể Thao KLI`} description={post.data.summary}>
  <article class="article-page">
    <div class="container article-container">
      
      <!-- BREADCRUMB -->
      <nav class="breadcrumb">
        <a href="/">Trang Chủ</a>
        <span>/</span>
        <a href="/bai-viet">Bài Viết & Đánh Giá</a>
        <span>/</span>
        <span class="current">{post.data.title}</span>
      </nav>

      <!-- ARTICLE HEADER -->
      <header class="article-header">
        <div class="article-meta-tags">
          <span class="category-badge">{post.data.category.toUpperCase()}</span>
          <span class="date-badge">📅 {new Date(post.data.publishedDate).toLocaleDateString('vi-VN')}</span>
          <span class="author-badge">✍️ {post.data.author}</span>
        </div>

        <h1 class="article-title">{post.data.title}</h1>

        {post.data.summary && (
          <p class="article-summary">{post.data.summary}</p>
        )}
      </header>

      <!-- HỘP ĐÁNH GIÁ XẾP HẠNG PHÒNG TẬP (THEO YÊU CẦU ĐẶC BIỆT CỦA PO/PM) -->
      {review && review.isReviewPost && (
        <section class="review-scorecard">
          <div class="scorecard-header">
            <div class="scorecard-badge">
              <span>🏆 XẾP HẠNG THẨM ĐỊNH KLI SPORTS</span>
            </div>
            <div class="scorecard-rank">
              {review.rankBadge}
            </div>
          </div>

          <div class="scorecard-body">
            <!-- Điểm tổng quan -->
            <div class="score-overall-col">
              <div class="overall-label">ĐIỂM TỔNG THỂ</div>
              <div class="overall-number">{review.overallRating}</div>
              <div class="overall-stars">⭐⭐⭐⭐⭐</div>
              <div class="overall-name">{review.venueName}</div>
            </div>

            <!-- Bảng điểm chi tiết 4 tiêu chí -->
            <div class="score-details-col">
              <h4 class="details-heading">BẢNG ĐIỂM TIÊU CHÍ THẨM ĐỊNH</h4>
              
              <div class="criteria-item">
                <div class="criteria-header">
                  <span>🏋️ Cơ sở vật chất & Máy móc:</span>
                  <strong>{review.facilityScore}</strong>
                </div>
                <div class="progress-bar"><div class="fill" style="width: 95%;"></div></div>
              </div>

              <div class="criteria-item">
                <div class="criteria-header">
                  <span>👨‍🏫 Đội ngũ HLV & Giảng viên:</span>
                  <strong>{review.coachScore}</strong>
                </div>
                <div class="progress-bar"><div class="fill" style="width: 92%;"></div></div>
              </div>

              <div class="criteria-item">
                <div class="criteria-header">
                  <span>💰 Mức giá & Quyền lợi Cali:</span>
                  <strong>{review.priceScore}</strong>
                </div>
                <div class="progress-bar"><div class="fill" style="width: 98%;"></div></div>
              </div>

              <div class="criteria-item">
                <div class="criteria-header">
                  <span>🚿 Vệ sinh & Tiện ích đi kèm:</span>
                  <strong>{review.cleanlinessScore}</strong>
                </div>
                <div class="progress-bar"><div class="fill" style="width: 94%;"></div></div>
              </div>
            </div>
          </div>

          <!-- Ưu điểm và Điểm lưu ý -->
          <div class="scorecard-pros-cons">
            <div class="pros-box">
              <h5>✅ ƯU ĐIỂM NỔI BẬT:</h5>
              <div class="text-content">{review.pros}</div>
            </div>

            <div class="cons-box">
              <h5>⚠️ ĐIỂM CẦN LƯU Ý:</h5>
              <div class="text-content">{review.cons}</div>
            </div>
          </div>

          <!-- Lời khuyên Kli Sports -->
          {review.verdict && (
            <div class="verdict-box">
              <div class="verdict-title">💡 LỜI KHUYÊN TỪ CỘNG ĐỒNG THỂ THAO KLI:</div>
              <p>{review.verdict}</p>
            </div>
          )}

          <div class="scorecard-action">
            <a href="https://zalo.me/g/klisports" target="_blank" class="btn-review-cta">
              <span>Nhận Ưu Đãi Hội Viên Kli Tại Cơ Sở Này (Qua Zalo)</span>
            </a>
          </div>
        </section>
      )}

      <!-- NỘI DUNG CHI TIẾT BÀI VIẾT -->
      <div class="article-content">
        <Content />
      </div>

      <!-- TAGS -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="article-tags">
          <span class="tag-title">Từ khóa liên quan:</span>
          {post.data.tags.map(t => (
            <span class="tag-item">#{t}</span>
          ))}
        </div>
      )}

      <!-- FOOTER CALLOUT -->
      <div class="article-cta-box">
        <h3>Cần Hỗ Trợ Chuyển Đổi Quyền Lợi Tập Luyện?</h3>
        <p>Tham gia ngay nhóm Zalo chính thức của Cộng Đồng Thể Thao Kli để được kết nối trực tiếp với các quản lý phòng tập đối tác.</p>
        <a href="https://zalo.me/g/klisports" target="_blank" class="btn-join-zalo">
          <span>💬 Tham Gia Nhóm Zalo Kli</span>
        </a>
      </div>

    </div>
  </article>
</Layout>

<style>
  .article-page {
    padding: 40px 0 80px;
  }
  .article-container {
    max-width: 860px;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 24px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .current {
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .article-header {
    margin-bottom: 36px;
  }
  .article-meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 16px;
    font-size: 13px;
  }
  .category-badge {
    background: var(--primary);
    color: #fff;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-weight: 700;
  }
  .date-badge, .author-badge {
    color: var(--text-muted);
  }
  .article-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 18px;
    color: #fff;
  }
  .article-summary {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.6;
    border-left: 3px solid var(--primary);
    padding-left: 16px;
    font-style: italic;
  }

  /* REVIEW SCORECARD STYLES */
  .review-scorecard {
    background: linear-gradient(135deg, #161b2a 0%, #111420 100%);
    border: 2px solid rgba(255, 42, 84, 0.4);
    border-radius: var(--radius-xl);
    padding: 30px;
    margin-bottom: 45px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
  .scorecard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 24px;
  }
  .scorecard-badge span {
    background: rgba(255, 42, 84, 0.15);
    color: var(--primary);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 800;
  }
  .scorecard-rank {
    font-size: 16px;
    font-weight: 800;
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    padding: 4px 12px;
    border-radius: var(--radius-md);
  }
  .scorecard-body {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 30px;
    margin-bottom: 24px;
  }
  .score-overall-col {
    background: rgba(0,0,0,0.3);
    border-radius: var(--radius-lg);
    padding: 24px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
  }
  .overall-label {
    font-size: 12px;
    font-weight: 800;
    color: var(--text-dim);
    letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .overall-number {
    font-size: 54px;
    font-weight: 900;
    color: #fbbf24;
    line-height: 1;
    margin-bottom: 6px;
  }
  .overall-stars {
    font-size: 18px;
    margin-bottom: 10px;
  }
  .overall-name {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
  }
  .score-details-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .details-heading {
    font-size: 14px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 14px;
    letter-spacing: 0.5px;
  }
  .criteria-item {
    margin-bottom: 12px;
  }
  .criteria-header {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    margin-bottom: 4px;
    color: #e2e8f0;
  }
  .progress-bar {
    height: 8px;
    background: rgba(255,255,255,0.08);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .progress-bar .fill {
    height: 100%;
    background: linear-gradient(90deg, #ff2a54, #10b981);
    border-radius: var(--radius-full);
  }
  .scorecard-pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }
  .pros-box, .cons-box {
    background: rgba(0,0,0,0.25);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }
  .pros-box h5 {
    color: var(--secondary);
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .cons-box h5 {
    color: #fbbf24;
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .scorecard-pros-cons .text-content {
    font-size: 13.5px;
    color: #cbd5e1;
    line-height: 1.6;
    white-space: pre-line;
  }
  .verdict-box {
    background: rgba(255, 42, 84, 0.08);
    border-left: 4px solid var(--primary);
    padding: 16px 20px;
    border-radius: 4px 8px 8px 4px;
    margin-bottom: 24px;
  }
  .verdict-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #ff6b8b;
    margin-bottom: 6px;
  }
  .verdict-box p {
    font-size: 14px;
    color: #f1f5f9;
    line-height: 1.6;
  }
  .scorecard-action {
    text-align: center;
  }
  .btn-review-cta {
    display: inline-block;
    padding: 12px 28px;
    background: linear-gradient(135deg, var(--primary), #e11d48);
    color: #fff;
    font-weight: 700;
    font-size: 14.5px;
    border-radius: var(--radius-full);
    transition: var(--transition-smooth);
    box-shadow: 0 4px 14px var(--primary-glow);
  }
  .btn-review-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 42, 84, 0.5);
  }

  /* ARTICLE BODY PROSE */
  .article-content {
    font-size: 16.5px;
    line-height: 1.8;
    color: #cbd5e1;
    margin-bottom: 40px;
  }
  .article-content :global(h2) {
    font-size: 24px;
    font-weight: 800;
    color: #fff;
    margin: 36px 0 16px;
  }
  .article-content :global(h3) {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    margin: 28px 0 12px;
  }
  .article-content :global(p) {
    margin-bottom: 20px;
  }
  .article-content :global(ul) {
    margin-bottom: 24px;
    padding-left: 24px;
  }
  .article-content :global(li) {
    margin-bottom: 8px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 20px 0;
    border-top: 1px solid var(--border-color);
    margin-bottom: 40px;
  }
  .tag-title {
    font-size: 13px;
    color: var(--text-dim);
  }
  .tag-item {
    font-size: 12.5px;
    color: #94a3b8;
    background: var(--bg-surface-elevated);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .article-cta-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 36px;
    text-align: center;
  }
  .article-cta-box h3 {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .article-cta-box p {
    font-size: 15px;
    color: var(--text-muted);
    max-width: 550px;
    margin: 0 auto 24px;
  }
  .btn-join-zalo {
    display: inline-block;
    padding: 12px 24px;
    background: #0068ff;
    color: #fff;
    font-weight: 700;
    border-radius: var(--radius-full);
  }

  @media (max-width: 768px) {
    .scorecard-body {
      grid-template-columns: 1fr;
    }
    .scorecard-pros-cons {
      grid-template-columns: 1fr;
    }
  }
</style>
