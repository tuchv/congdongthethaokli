---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => {
  return data.status === 'published';
});

// Sắp xếp bài mới nhất lên đầu
posts.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());
---

<Layout title="Góc Đánh Giá & Tin Tức Thể Thao | Cộng Đồng KLI" description="Chuyên mục thẩm định phòng tập, review sân bãi, cẩm nang phục hồi và tin tức mới nhất từ Cộng Đồng Thể Thao Kli.">
  <main class="blog-hub-page">
    <div class="container">
      
      <!-- HERO HEADER -->
      <header class="hub-header">
        <span class="hub-badge">📰 GÓC TIN TỨC & THẨM ĐỊNH</span>
        <h1 class="hub-title">BÀI VIẾT & ĐÁNH GIÁ PHÒNG TẬP</h1>
        <p class="hub-desc">
          Thông tin minh bạch, đánh giá thực tế từ hội viên Kli Sports giúp bạn chọn được không gian tập luyện ưng ý nhất.
        </p>
      </header>

      <!-- POSTS GRID -->
      <div class="posts-grid">
        {posts.map(post => {
          const slug = post.id.replace(/\.(md|mdoc|mdx)$/, '');
          const review = post.data.venueReview;
          
          return (
            <article class="post-card">
              <div class="post-card-thumb">
                <img 
                  src={post.data.coverImage || "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=800&q=80"} 
                  alt={post.data.title} 
                />
                <span class="post-cat-badge">{post.data.category.toUpperCase()}</span>
                {review && review.isReviewPost && (
                  <div class="post-rating-tag">
                    ★ {review.overallRating} ({review.rankBadge})
                  </div>
                )}
              </div>

              <div class="post-card-body">
                <div class="post-card-meta">
                  <span>📅 {new Date(post.data.publishedDate).toLocaleDateString('vi-VN')}</span>
                  <span>•</span>
                  <span>✍️ {post.data.author}</span>
                </div>

                <h2 class="post-card-title">
                  <a href={`/bai-viet/${slug}`}>{post.data.title}</a>
                </h2>

                {post.data.summary && (
                  <p class="post-card-excerpt">{post.data.summary}</p>
                )}

                <div class="post-card-footer">
                  <a href={`/bai-viet/${slug}`} class="btn-read-more">
                    <span>Đọc chi tiết</span>
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 256 256">
                      <path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </main>
</Layout>

<style>
  .blog-hub-page {
    padding: 60px 0 90px;
  }
  .hub-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 50px;
  }
  .hub-badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(255, 42, 84, 0.12);
    border: 1px solid rgba(255, 42, 84, 0.3);
    color: var(--primary);
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 16px;
  }
  .hub-title {
    font-size: clamp(30px, 4.5vw, 46px);
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }
  .hub-desc {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 30px;
  }

  .post-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: var(--transition-smooth);
  }
  .post-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-lg);
  }

  .post-card-thumb {
    position: relative;
    height: 220px;
    width: 100%;
    overflow: hidden;
    background: #191f2e;
  }
  .post-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .post-card:hover .post-card-thumb img {
    transform: scale(1.06);
  }

  .post-cat-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(11, 13, 19, 0.85);
    border: 1px solid rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .post-rating-tag {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background: rgba(255, 42, 84, 0.95);
    color: #fff;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 700;
  }

  .post-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .post-card-meta {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  .post-card-title {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 12px;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card-title a:hover {
    color: var(--primary);
  }
  .post-card-excerpt {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
  }
  .btn-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary);
    font-size: 14px;
    font-weight: 700;
  }
  .btn-read-more:hover {
    color: var(--primary-hover);
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
